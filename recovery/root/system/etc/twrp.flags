# Opciones de TWRP (formato v1). Complementa a recovery.fstab (formato v2).
/boot           emmc  /dev/block/platform/bootdevice/by-name/boot           flags=display="Boot";slotselect;backup;flashimg
/dtbo           emmc  /dev/block/platform/bootdevice/by-name/dtbo           flags=display="DTBO";slotselect;backup;flashimg
/vbmeta         emmc  /dev/block/platform/bootdevice/by-name/vbmeta         flags=display="VBMeta";slotselect;backup;flashimg
/vbmeta_system  emmc  /dev/block/platform/bootdevice/by-name/vbmeta_system  flags=display="VBMeta System";slotselect;backup;flashimg
/logo           emmc  /dev/block/platform/bootdevice/by-name/logo           flags=display="Boot Logo";slotselect;backup;flashimg
/super          emmc  /dev/block/by-name/super                              flags=display="Super";backup;flashimg
/metadata       ext4  /dev/block/platform/bootdevice/by-name/md_udc         flags=display="Metadata";backup
/nvram          emmc  /dev/block/platform/bootdevice/by-name/nvram          flags=display="NVRAM (IMEI)";backup
/nvdata         ext4  /dev/block/platform/bootdevice/by-name/nvdata         flags=display="NVData";backup
/nvcfg          ext4  /dev/block/platform/bootdevice/by-name/nvcfg          flags=display="NVCfg";backup
/protect_f      ext4  /dev/block/platform/bootdevice/by-name/protect1       flags=display="Protect F";backup
/protect_s      ext4  /dev/block/platform/bootdevice/by-name/protect2       flags=display="Protect S";backup
/persist_image  emmc  /dev/block/platform/bootdevice/by-name/persist        flags=display="Persist";backup
/proinfo        emmc  /dev/block/platform/bootdevice/by-name/proinfo        flags=display="Proinfo";backup
